# Copy this file to ".env" and fill in your real values.
# Never share your real .env file or upload it publicly (e.g. to GitHub).

# From @BotFather after /newbot
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Your channel's numeric ID (get it via @JsonDumpBot or @userinfobot)
# Looks like: -1001234567890
CHANNEL_ID=-1001234567890

# Your channel's public link or invite link
CHANNEL_INVITE_LINK=https://t.me/your_channel_username

# Your own numeric Telegram user ID (for /stats access). Get it from @userinfobot.
ADMIN_ID=123456789

# How many verified referrals a user needs before they get the service
REQUIRED_REFERRALS=2

# --- Recommended: tappable buttons instead of flat text ---
# One or more items, separated by semicolons. Each item is: Label|type|value
#   type = url   -> tapping opens the link immediately (no bot round-trip)
#   type = file  -> tapping sends the file at that path (must be in your repo)
#   type = code  -> tapping sends the value as a tap-to-copy code block
#   type = text  -> tapping sends the value as a plain message
# Leave SERVICES empty to fall back to the single SERVICE_TYPE/SERVICE_TEXT below.
SERVICES=🔗 Premium Link|url|https://t.me/+your_private_link;📄 Bonus PDF|file|bonus.pdf;🎟 Promo Code|code|SAVE20NOW

# --- Legacy fallback (only used if SERVICES is left empty) ---
# SERVICE_TYPE = "text"  -> sends SERVICE_TEXT as a message (put your link/code inside it)
# SERVICE_TYPE = "file"  -> sends the file at SERVICE_FILE_PATH, with SERVICE_TEXT as caption
SERVICE_TYPE=text
SERVICE_TEXT=Here is your invite link: https://t.me/+your_private_link
SERVICE_FILE_PATH=
