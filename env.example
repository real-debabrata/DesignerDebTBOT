# Copy this file to ".env" and fill in your real values.
# Never share your real .env file or upload it publicly (e.g. to GitHub).

# From @BotFather after /newbot
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Your own numeric Telegram user ID — this is who can use /admin, /stats,
# and /addref. Get it from @userinfobot. This can ONLY be changed here,
# never from inside the bot (for security).
ADMIN_ID=123456789

# ---------------------------------------------------------------------
# Everything below this line is just the STARTING value. Once the bot is
# running, you can change all of it from inside Telegram — send /admin
# and use the buttons. Editing these lines later and redeploying will NOT
# overwrite a value you already changed via /admin.
# ---------------------------------------------------------------------

# Your channel's numeric ID (get it via @JsonDumpBot or @userinfobot)
# Looks like: -1001234567890
CHANNEL_ID=-1001234567890

# Your channel's public link or invite link
CHANNEL_INVITE_LINK=https://t.me/your_channel_username

# --- Rewards users can redeem with their referral balance ---
# One or more items, separated by semicolons. Each item is:
#   Label|type|value|cost
#   type = url    -> tapping opens the link immediately (only if cost is 0 —
#                     anything with a cost always routes through the bot
#                     first so it can check the user's balance)
#   type = file   -> tapping sends the file at that path (must be in your repo)
#   type = code   -> tapping sends the value as a tap-to-copy code block
#   type = text   -> tapping sends the value as a plain message
#   type = redeem -> tapping asks the user for their email, then logs the
#                     request (email + product) for YOU to fulfill by hand.
#                     Use this for anything you can't auto-deliver, like a
#                     Canva Pro subscription. "value" here is just the
#                     product description shown in your notifications/sheet.
#   cost = how many verified referrals this item requires. 0 = free/instant.
# Leave SERVICES empty to fall back to the single SERVICE_TYPE/SERVICE_TEXT below.
# Easier option: leave this empty and add items from /admin -> Rewards
# instead — you can upload a file straight through Telegram there, and it
# walks you through picking the type and cost.
SERVICES=🎟 Promo Code|code|SAVE20NOW|0;📄 Bonus PDF|file|bonus.pdf|0;🎨 Canva Pro — 1 Year|redeem|Canva Pro - 1 Year Subscription|4

# --- Legacy fallback (only used if SERVICES is left empty) ---
# SERVICE_TYPE = "text"  -> sends SERVICE_TEXT as a message (put your link/code inside it)
# SERVICE_TYPE = "file"  -> sends the file at SERVICE_FILE_PATH, with SERVICE_TEXT as caption
SERVICE_TYPE=text
SERVICE_TEXT=Here is your invite link: https://t.me/+your_private_link
SERVICE_FILE_PATH=

# ---------------------------------------------------------------------
# Optional: log every "redeem" request to a Google Sheet too (recommended,
# since Render's free plan wipes local storage on restart). Leave both
# blank to skip this — redemptions still land in the local DB, are
# exportable as a CSV from /admin any time, and you get an instant
# Telegram DM for every one regardless. See GOOGLE_SHEETS_SETUP.md.
# ---------------------------------------------------------------------
# The entire service-account JSON key file, pasted as ONE line.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The long ID in your sheet's URL: .../spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
# Optional — which tab/worksheet to log to. Created automatically if missing.
GOOGLE_SHEET_WORKSHEET=Redemptions
